{
  "name": "quill-table-better",
  "version": "1.2.4",
  "description": "A module that enhances the table functionality of Quill",
  "main": "dist/quill-table-better.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "webpack-dev-server --config config/webpack.dev.js",
    "build": "webpack --config config/webpack.prod.js && node -e \"require('fs').rmSync('dist/quill-table-better', { force: true })\"",
    "test": "node tests/build.cjs && playwright test",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --noEmit --target es6 --moduleResolution node --allowSyntheticDefaultImports tests/consumer.ts",
    "verify": "npm run typecheck && npm run build && npm run test:types && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/attoae/quill-table-better.git"
  },
  "keywords": [
    "quill",
    "quill.js",
    "quill-table"
  ],
  "author": "attoae",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/attoae/quill-table-better/issues"
  },
  "homepage": "https://github.com/attoae/quill-table-better#readme",
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/plugin-transform-runtime": "^7.24.3",
    "@babel/preset-env": "^7.24.5",
    "@playwright/test": "1.62.1",
    "@types/lodash.merge": "^4.6.7",
    "@types/node": "20.19.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.7.1",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.6.0",
    "parchment": "^3.0.0",
    "quill": "^2.0.1",
    "sass": "^1.51.0",
    "sass-loader": "^12.6.0",
    "ts-loader": "^9.3.0",
    "typescript": "5.9.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-merge": "^5.8.0"
  },
  "engines": {
    "node": ">= 14.15.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.17.9",
    "@jaames/iro": "^5.5.2",
    "lodash.merge": "^4.6.2",
    "quill-delta": "^5.1.0"
  },
  "peerDependencies": {
    "quill": "^2.0.0"
  },
  "browserslist": [
    "last 1 version",
    "> 1%",
    "IE 10"
  ]
}
